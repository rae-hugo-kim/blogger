# Harness runtime state (OMP)
.omp/harness-state/
.omp/state/

# Hugo
public/
.hugo_build.lock
resources/_gen/

# Python
__pycache__/
*.pyc
.venv/

# OMC state (transient)
.omc/

# Serena tool state (transient)
.serena/

# Environment variables
.env*
